/*
 * tecla-cero keymap
 *
 * 38-key split keyboard (left 19 + right 19)
 * 3 layers + rotary encoder
 *
 * ZMK Studio enabled for live editing
 */

#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <60>;
        };
    };

    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        left-click {
            bindings = <&mkp MB1>;
            key-positions = <16 17>;
        };

        right-click {
            bindings = <&mkp MB2>;
            key-positions = <17 18>;
        };

        gui {
            bindings = <&kp LEFT_GUI>;
            key-positions = <37 36>;
        };

        lt_5 {
            bindings = <&lt 5 ESCAPE>;
            key-positions = <33 34>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * Layer 0: Default (QWERTY)
         *
         * ┌───┬───┬───┬───┬───┐   ┌───┬───┬───┬───┬───┐
         * │ Q │ W │ E │ R │ T │   │ Y │ U │ I │ O │ P │
         * ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
         * │ A │ S │ D │ F │ G │   │ H │ J │ K │ L │ ; │
         * ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
         * │ Z │ X │ C │ V │ B │   │ N │ M │ , │ . │BSP│
         * ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
         * │CTL│SFT│   │LWR│SPC│   │ENT│RSE│   │ALT│CTL│
         * └───┴───┴───┴───┴───┘   └───┴───┴───┴───┴───┘
         */

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E  &kp R        &kp T      &kp Y            &kp U        &kp I      &kp O     &kp P
&kp A             &kp S         &kp D  &kp F        &kp G      &kp H            &kp J        &kp K      &kp L     &kp SEMI
&mt LEFT_SHIFT Z  &kp X         &kp C  &kp V        &kp B      &kp N            &kp M        &kp COMMA  &kp DOT   &mt RIGHT_SHIFT SLASH
&mt LCTRL LANG1   &kp LEFT_ALT         &lt 4 SPACE  &lt 2 DEL  &lt 1 BACKSPACE  &lt 3 ENTER             &kp RALT  &mt RCTRL LANGUAGE_2
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        /*
         * Layer 1: Lower (Numbers / Navigation)
         *
         * ┌───┬───┬───┬───┬───┐   ┌───┬───┬───┬───┬───┐
         * │ 1 │ 2 │ 3 │ 4 │ 5 │   │ 6 │ 7 │ 8 │ 9 │ 0 │
         * ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
         * │TAB│   │   │ESC│   │   │ ← │ ↓ │ ↑ │ → │BSP│
         * ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
         * │SFT│   │   │   │   │   │HOM│PGD│PGU│END│DEL│
         * ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
         * │   │   │   │▓▓▓│   │   │   │   │   │   │   │
         * └───┴───┴───┴───┴───┘   └───┴───┴───┴───┴───┘
         */

        layer_1 {
            bindings = <
&kp N1     &kp N2  &kp N3                &kp N4                 &kp N5  &kp N6        &kp N7            &kp N8             &kp N9  &kp N0
&kp TAB    &none   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none   &none         &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none   &kp BACKSLASH
&kp LSHFT  &none   &kp LEFT_BRACE        &kp RIGHT_BRACE        &none   &kp LEFT_GUI  &none             &none              &none   &kp LS(BACKSLASH)
&trans     &trans                        &trans                 &trans  &trans        &trans                               &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp RIGHT LEFT_ARROW>;
        };

        /*
         * Layer 2: Raise (Symbols / Function / Bluetooth)
         *
         * ┌───┬───┬───┬───┬───┐   ┌───┬───┬───┬───┬───┐
         * │ ! │ @ │ # │ $ │ % │   │ ^ │ & │ * │ ( │ ) │
         * ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
         * │F1 │F2 │F3 │F4 │F5 │   │ - │ = │ [ │ ] │ \ │
         * ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
         * │F6 │F7 │F8 │F9 │F10│   │ _ │ + │ { │ } │ | │
         * ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
         * │BT1│BT2│   │BT3│   │   │   │▓▓▓│   │F11│F12│
         * └───┴───┴───┴───┴───┘   └───┴───┴───┴───┴───┘
         */

        layer_2 {
            bindings = <
&kp EXCL   &kp AT     &kp HASH  &kp DLLR           &kp PRCNT  &kp CARET  &kp AMPS  &kp ASTRK  &kp MINUS  &kp UNDERSCORE
&kp GRAVE  &kp TILDE  &kp SQT   &kp DOUBLE_QUOTES  &none      &kp F11    &kp F12   &none      &kp EQUAL  &kp PLUS
&kp F1     &kp F2     &kp F3    &kp F4             &kp F5     &kp F6     &kp F7    &kp F8     &kp F9     &kp F10
&trans     &trans               &trans             &trans     &trans     &trans               &trans     &trans
            >;
        };

        layer_3 {
            bindings = <
&kp LS(LC(TAB))  &kp LC(TAB)  &kp LG(E)  &kp LG(R)  &kp LC(T)  &kp LC(Y)  &kp PAGE_UP     &kp UP_ARROW    &kp PAGE_DOWN    &kp PRINTSCREEN
&kp LC(A)        &kp LC(S)    &kp LG(D)  &kp LC(F)  &kp LC(G)  &kp HOME   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END
&kp LC(Z)        &kp LC(X)    &kp LC(C)  &kp LC(V)  &kp LC(B)  &none      &none           &none           &none            &kp INSERT
&trans           &trans                  &trans     &trans     &trans     &trans                          &bootloader      &trans
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        layer_4 {
            bindings = <
&none                   &none                   &kp LG(UP_ARROW)    &none                    &none                    &none   &mkp MB4  &mkp MB3  &none   &none
&kp LC(LG(LEFT_ARROW))  &kp LS(LG(LEFT_ARROW))  &kp LG(DOWN_ARROW)  &kp LS(LG(RIGHT_ARROW))  &kp LC(LG(RIGHT_ARROW))  &none   &mkp MB1  &mkp MB2  &none   &none
&none                   &none                   &none               &none                    &none                    &none   &none     &none     &none   &none
&trans                  &bootloader                                 &trans                   &trans                   &trans  &trans              &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&bootloader     &none   &none  &none   &none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&sys_reset      &none   &none  &none   &none   &none         &none         &none         &none         &none
&studio_unlock  &none   &none  &none   &none   &none         &none         &none         &bt BT_CLR    &bt BT_CLR_ALL
&trans          &trans         &trans  &trans  &trans        &trans                      &trans        &trans
            >;
        };
    };
};
